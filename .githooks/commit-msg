#!/usr/bin/env python3
"""Strip Cursor auto-attribution trailers from the commit message.

Cursor injects `--trailer "Co-authored-by: Cursor <cursoragent@cursor.com>"`
when Agent commit attribution is on. This hook drops those lines so the
recorded commit stays under the author's name only. Other Co-authored-by
trailers are left untouched.
"""

from __future__ import annotations

import re
import sys
from pathlib import Path

_DROP = re.compile(
    r"^(?:"
    r"Co-authored-by:\s*Cursor\b"
    r"|Co-authored-by:.*cursoragent@cursor\.com"
    r"|Made-with:\s*Cursor\b"
    r")",
    re.IGNORECASE,
)


def strip_cursor_trailers(text: str) -> str:
    kept = [line for line in text.splitlines() if not _DROP.match(line.strip())]
    body = "\n".join(kept).rstrip() + "\n"
    return re.sub(r"\n{3,}", "\n\n", body)


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print("usage: commit-msg <message-file>", file=sys.stderr)
        return 1
    path = Path(argv[1])
    original = path.read_text(encoding="utf-8")
    cleaned = strip_cursor_trailers(original)
    if not cleaned.strip():
        print("ERROR: commit message empty after stripping Cursor trailers", file=sys.stderr)
        return 1
    if cleaned != original:
        path.write_text(cleaned, encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
